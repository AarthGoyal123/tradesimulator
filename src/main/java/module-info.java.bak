module com.tradesim.tradesim {
    requires javafx.controls;
    requires javafx.fxml;
    requires org.xerial.sqlitejdbc;
    requires spring.context;
    requires spring.boot;
    requires spring.boot.autoconfigure;
    requires spring.web;
    requires spring.jdbc;
    requires spring.beans;
    requires spring.core;
    requires spring.expression;
    requires jakarta.annotation;

    opens com.tradesim.tradesim to javafx.graphics, spring.core, spring.beans;
    opens com.tradesim.tradesim.ui to javafx.graphics, spring.core;
    opens com.tradesim.tradesim.db to javafx.graphics, spring.core, spring.beans;
    opens com.tradesim.tradesim.model to javafx.graphics, spring.core;
    opens com.tradesim.tradesim.controller to spring.web;

    exports com.tradesim.tradesim;
}